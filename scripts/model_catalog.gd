const EQUIPMENT: Dictionary = {
	"digital_scale": {"path": "res://assets/models/catalog/equipment/digital_scale.glb"},
	"metal_grill": {"path": "res://assets/models/catalog/equipment/metal_grill.glb"},
	"metal_rack": {"path": "res://assets/models/catalog/equipment/metal_rack.glb"},
}

static var _pools: Dictionary = {}
static var _given: Dictionary = {}
static var _scenes: Dictionary = {}


# Draws the next sculpt for a floor product. The first deck-size draws of
# every department are guaranteed, so a full run shows each model at least
# once even when the deck is larger than the expected hero count.
static func take(dept: int, rng: RandomNumberGenerator) -> Dictionary:
	if not DECKS.has(dept):
		return {}
	var given: int = _given.get(dept, 0)
	var deck_size: int = (DECKS[dept] as Array).size()
	if given >= deck_size and rng.randf() >= CHANCE[dept]:
		return {}
	_given[dept] = given + 1
	return pick(dept)


# Next sculpt for this department, cycling through a freshly shuffled deck
# each time it runs out.
static func pick(dept: int) -> Dictionary:
	if not DECKS.has(dept):
		return {}
	var pool: Array = _pools.get(dept, [])
	if pool.is_empty():
		pool = (DECKS[dept] as Array).duplicate()
		pool.shuffle()
		_pools[dept] = pool
	return pool.pop_back()


static func scene(path: String) -> PackedScene:
	if not _scenes.has(path):
		var packed := load(path) as PackedScene
		_scenes[path] = packed
	return _scenes[path]


static func equipment(name: String) -> PackedScene:
	if not EQUIPMENT.has(name):
		return null
	return scene(String(EQUIPMENT[name]["path"]))
